{
  "manifestVersion": 5,
  "id": "com.starbridge.photoshop.bridge",
  "name": "KORYAO Photoshop Bridge",
  "version": "1.3.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "ws://127.0.0.1:8971",
        "http://127.0.0.1:8971"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "starbridgePhotoshopLivePanel",
      "label": {"default": "Codex Live"},
      "minimumSize": {"width": 280, "height": 420},
      "preferredDockedSize": {"width": 320, "height": 560},
      "preferredFloatingSize": {"width": 360, "height": 620}
    },
    {
      "type": "command",
      "id": "starbridgePing",
      "label": "KORYAO Ping"
    }
  ]
}
